USEMODULE += cc26xx_cc13xx

include ${RIOTCPU}/cc26xx_cc13xx/Makefile.dep

# The 2.4 GHz band is a variant of the radio driver
ifneq (,$(filter cc26x2_cc13x2_rf_24ghz,$(USEMODULE)))
  ifneq (,$(filter cc1312%,$(CPU_MODEL)))
    $(error The CC1312 has no 2.4 GHz radio: cc26x2_cc13x2_rf_24ghz)
  endif
  USEMODULE += cc26x2_cc13x2_rf
  # the seed of the CSMA-CA backoffs
  USEMODULE += random
endif

ifneq (,$(filter cc26x2_cc13x2_rf,$(USEMODULE)))
  USEMODULE += cc26x2_cc13x2_rfc
  USEMODULE += cc26x2_cc13x2_rf_patches
  ifneq (,$(filter netdev,$(USEMODULE)))
    USEMODULE += netdev_ieee802154_submac
  endif
  ifeq (,$(filter cc26x2_cc13x2_rf_24ghz,$(USEMODULE)))
    ifneq (,$(filter netdev,$(USEMODULE)))
      # The only PHY of the sub-GHz radio is MR-FSK. Without this module the
      # SubMAC rejects the PHY configuration at start-up and never passes it
      # to the radio. It cannot be selected without netdev: every netdev_%
      # module pulls netdev in.
      USEMODULE += netdev_ieee802154_mr_fsk
    endif
    ifneq (,$(filter ieee802154_submac,$(USEMODULE)))
      # The sub-GHz radio sends ACKs itself, but it has no CSMA-CA, does not
      # wait for ACKs and does not retransmit: the SubMAC has to do all
      # three. Without these modules it assumes the radio does, and reports
      # every frame as sent and acknowledged. In the 2.4 GHz band the RF
      # Core does all of it.
      USEMODULE += ieee802154_submac_soft_csma_ca
      USEMODULE += ieee802154_submac_soft_frame_retrans
    endif
  endif
endif
