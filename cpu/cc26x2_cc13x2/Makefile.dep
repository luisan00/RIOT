USEMODULE += cc26xx_cc13xx

include ${RIOTCPU}/cc26xx_cc13xx/Makefile.dep

ifneq (,$(filter cc26x2_cc13x2_rf,$(USEMODULE)))
  USEMODULE += cc26x2_cc13x2_rfc
  USEMODULE += cc26x2_cc13x2_rf_patches
  ifneq (,$(filter netdev,$(USEMODULE)))
    USEMODULE += netdev_ieee802154_submac
    # The only PHY of the radio is MR-FSK. Without this module the SubMAC
    # rejects the PHY configuration at start-up and never passes it to the
    # radio. It cannot be selected without netdev: every netdev_% module
    # pulls netdev in.
    USEMODULE += netdev_ieee802154_mr_fsk
  endif
endif
